	<parameter name="tgl" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    s.nis AS siswa_nis,
    s.nama_siswa AS siswa_nama_siswa,

    MAX(CASE WHEN p.id_kriteria=1 THEN p.nilai END) AS Akademik,
    MAX(CASE WHEN p.id_kriteria=2 THEN p.nilai END) AS Absensi,
    MAX(CASE WHEN p.id_kriteria=3 THEN p.nilai END) AS Sikap,
    MAX(CASE WHEN p.id_kriteria=4 THEN p.nilai END) AS Keaktifan,
    MAX(CASE WHEN p.id_kriteria=5 THEN p.nilai END) AS NonAkademik

FROM siswa s
JOIN penilaian p ON s.id_siswa=p.id_siswa

GROUP BY
s.id_siswa,
s.nis,
s.nama_siswa
ORDER BY s.nis;]]>
	</queryString>
	<field name="siswa_nis" class="java.lang.String"/>
	<field name="siswa_nama_siswa" class="java.lang.String"/>
	<field name="Akademik" class="java.lang.String"/>
