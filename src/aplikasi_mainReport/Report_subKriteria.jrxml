	<parameter name="tgl" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
     kriteria.`id_kriteria` AS kriteria_id_kriteria,
     kriteria.`kode_kriteria` AS kriteria_kode_kriteria,
     kriteria.`nama_kriteria` AS kriteria_nama_kriteria,
     kriteria.`bobot` AS kriteria_bobot,
     kriteria.`atribut` AS kriteria_atribut,
     sub_kriteria.`id_sub` AS sub_kriteria_id_sub,
     sub_kriteria.`id_kriteria` AS sub_kriteria_id_kriteria,
     sub_kriteria.`keterangan` AS sub_kriteria_keterangan,
     sub_kriteria.`nilai` AS sub_kriteria_nilai
FROM
     `kriteria` kriteria INNER JOIN `sub_kriteria` sub_kriteria ON kriteria.`id_kriteria` = sub_kriteria.`id_kriteria`]]>
	</queryString>
