	<property name="ireport.zoom" value="1.7715610000000042"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tgl" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    h.ranking,
    s.nis,
    s.nama_siswa,
    h.nilai_preferensi,
    CASE
        WHEN h.nilai_preferensi BETWEEN 0.90 AND 1.00 THEN 'Sangat Berprestasi'
        WHEN h.nilai_preferensi BETWEEN 0.80 AND 0.89 THEN 'Berprestasi'
        WHEN h.nilai_preferensi BETWEEN 0.70 AND 0.79 THEN 'Cukup'
        WHEN h.nilai_preferensi BETWEEN 0.60 AND 0.69 THEN 'Kurang'
        ELSE 'Sangat Kurang'
    END AS keterangan
FROM hasil h
JOIN siswa s
ON h.id_siswa = s.id_siswa
ORDER BY h.ranking ASC;]]>
	</queryString>
